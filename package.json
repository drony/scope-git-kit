{
  "name": "finscope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && npm run build:apps",
    "build:apps": "APP=finscope vite build && APP=contest vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && npm run check:layers && npm run docs:check",
    "check:layers": "node scripts/check-layers.mjs",
    "docs": "node scripts/build-docs.ts",
    "docs:check": "node scripts/build-docs.ts --check",
    "dev:contest": "APP=contest vite",
    "build:finscope": "npm run check && APP=finscope vite build",
    "build:contest": "APP=contest vite build"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
